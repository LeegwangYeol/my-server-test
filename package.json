{
  "name": "my-api",
  "version": "1.0.50",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "bundle:api": "node scripts/build-migrations.mjs && npx esbuild lambda-src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=api/index.js --legal-comments=none",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "bun test",
    "mail:test": "node --env-file=.env scripts/send-test-mail.ts",
    "mail:send": "node --no-warnings --env-file=.env scripts/send-mail.ts",
    "greetings": "node --env-file=.env test/sms-local/send-greetings.ts",
    "widget:upsert": "node --env-file=.env scripts/upsert-widget.ts",
    "sms:usage": "node --env-file=.env test/sms-local/sms-usage.ts",
    "sms:devices": "node --env-file=.env test/sms-local/sms-devices.ts",
    "sms:verify": "node --env-file=.env test/sms-local/sms-verify.ts",
    "introspection": "npx supabase gen types typescript --schema public --project-id pddzchdkbwhhbtpmagsx > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "1.1.1",
    "@sinclair/typebox": "^0.34.49",
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "elysia": "latest",
    "exact-mirror": "^1.0.0",
    "file-type": "^22.0.1",
    "googleapis": "^144.0.0",
    "nodemailer": "^8.0.10",
    "openapi-types": "^12.1.3",
    "typescript": "5.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "bun-types": "^1.1.33",
    "esbuild": "^0.28.0",
    "prettier": "^3.3.3"
  },
  "module": "src/index.js"
}
