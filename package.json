{
  "name": "my-api",
  "version": "1.0.50",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "bundle:api": "node scripts/build-migrations.mjs && npx esbuild lambda-src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.js --legal-comments=none",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "bun test",
    "mail:test": "node --env-file=.env scripts/send-test-mail.ts",
    "greetings": "node --env-file=.env scripts/send-greetings.ts",
    "widget:upsert": "node --env-file=.env scripts/upsert-widget.ts",
    "introspection": "npx supabase gen types typescript --schema public --project-id pddzchdkbwhhbtpmagsx > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.484.0",
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/cron": "^1.1.1",
    "@elysiajs/swagger": "1.1.1",
    "@langchain/community": "^0.3.12",
    "@langchain/core": "^0.3.17",
    "@langchain/textsplitters": "^0.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@supabase/supabase-js": "^2.43.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "elysia": "latest",
    "exact-mirror": "^1.0.0",
    "fetch-event-stream": "^0.1.5",
    "fetch-retry": "^6.0.0",
    "file-type": "^22.0.1",
    "google-libphonenumber": "^3.2.38",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "nodemailer": "^8.0.10",
    "officeparser": "^5.0.0",
    "openai": "^4.68.4",
    "openapi-types": "^12.1.3",
    "pdf-parse": "^1.1.1",
    "pseudo-shuffle": "^1.0.2",
    "redaxios": "^0.5.1",
    "typescript": "5.4.3"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.0",
    "bun-types": "^1.1.33",
    "esbuild": "^0.28.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "module": "src/index.js",
  "lint-staged": {
    "**/*.{js,ts,json,md}": [
      "prettier --write"
    ]
  }
}
