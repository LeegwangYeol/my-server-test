{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["lib/**", "src/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "framework": null,
  "functions": {
    "src/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
