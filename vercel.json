{
  "version": 2,
  "builds": [
    {
      "src": "src/serverless.ts",
      "use": "@vercel/node@2.15.3",
      "config": {
        "includeFiles": ["lib/**", "src/**"],
        "nodeVersion": "18.x",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/serverless.ts"
    }
  ],
  "framework": null,
  "env": {
    "NODE_ENV": "production"
  }
}
