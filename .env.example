# ════════════════════════════════════════════════════════════════════════
#  LLM provider configuration — drives /v2/ask
# ════════════════════════════════════════════════════════════════════════
#
# Set LLM_API_KEY to switch /v2/ask from the canned fallback to a real
# streaming LLM response. Leave it blank to keep the demo behavior.
#
# ─ Which vendor? ────────────────────────────────────────────────────────
# Built-in presets (each one just needs its key + optional model):
#
#   openrouter   ← recommended for trying multiple models with one key
#                  Get a key: https://openrouter.ai/keys
#                  Model names: "openai/gpt-4o-mini",
#                               "anthropic/claude-3.5-sonnet",
#                               "meta-llama/llama-3.1-70b-instruct", ...
#
#   openai       https://platform.openai.com/api-keys
#                Models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#
#   groq         https://console.groq.com/keys      (very fast inference)
#                Models: llama-3.1-70b-versatile, mixtral-8x7b-32768
#
#   together     https://api.together.xyz/settings/api-keys
#                Models: meta-llama/Llama-3.1-70B-Instruct-Turbo, ...
#
#   deepseek     https://platform.deepseek.com/api_keys
#                Models: deepseek-chat, deepseek-coder
#
#   mistral      https://console.mistral.ai/api-keys/
#                Models: mistral-small-latest, mistral-large-latest
#
#   fireworks    https://fireworks.ai/account/api-keys
#                Models: accounts/fireworks/models/llama-v3p1-70b-instruct
#
#   custom       Any OpenAI-compatible endpoint — set LLM_BASE_URL too.
#                Examples: self-hosted Ollama, LM Studio, vLLM.
# ─────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=openrouter

#  ⚠️  PUT YOUR API TOKEN HERE  ⚠️
LLM_API_KEY=

# Override the default model for the chosen provider. Optional.
# LLM_MODEL=openai/gpt-4o-mini

# Only required when LLM_PROVIDER=custom.
# LLM_BASE_URL=http://localhost:11434/v1

# Optional: hard cap on output tokens per reply (default 512).
# Keep this low on free tiers — OpenRouter's free credits often allow
# only ~1000 tokens per request and rejects bigger ones with HTTP 402.
# LLM_MAX_TOKENS=512

# Optional: change the assistant's persona.
# LLM_SYSTEM_PROMPT="You are a friendly assistant for example.com."

# Optional: OpenRouter-only attribution headers (shown on its dashboard).
# LLM_REFERER=https://my-server-test.vercel.app
# LLM_TITLE=Tokki Widget


# ════════════════════════════════════════════════════════════════════════
#  Naver SMTP mail — drives POST /v2/admin/mail/send
# ════════════════════════════════════════════════════════════════════════
#
# Sends mail through smtp.naver.com:465. Before this works you must, in the
# Naver account that sends the mail:
#   메일 > 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용 → 사용함
# If the account has 2-step verification on, generate an app password and
# use THAT here instead of the login password.
#
# NAVER_MAIL_USER must be the full address (it is also the default From).
# NAVER_MAIL_USER=yourid@naver.com
# NAVER_MAIL_PASSWORD=
# Optional display name on the From header.
# NAVER_MAIL_FROM_NAME=Tokki


# ════════════════════════════════════════════════════════════════════════
#  SMS — POST /v2/admin/sms/send & scripts/send-greetings.ts (명절 인사 일괄발송)
# ════════════════════════════════════════════════════════════════════════
#
# 어떤 방식으로 문자를 보낼지 고릅니다:
#   SMS_PROVIDER=pushbullet  Pushbullet(Play스토어 정식 앱) — 본인 폰이 발송, 0원,
#                            APK 사이드로드 불필요. 무료 계정 월 ~100건 한도.
#   SMS_PROVIDER=phone       안드로이드 폰 게이트웨이 SMS Gate (APK 설치, 0원, 한도없음)
#   SMS_PROVIDER=solapi      SOLAPI(구 CoolSMS), 건당 과금
SMS_PROVIDER=phone

# ── Pushbullet (Play스토어 정식 앱, 본인 안드로이드폰이 발송) ────────────
# 1) Play스토어에서 "Pushbullet" 설치(개발사 Pushbullet), 구글 로그인, SMS 권한 허용
# 2) pushbullet.com > Settings > Account > Create Access Token
# 3) device iden: pushbullet.com 왼쪽에서 폰 선택 시 URL 끝 부분, 또는
#    curl -H "Access-Token: 토큰" https://api.pushbullet.com/v2/devices
# PUSHBULLET_ACCESS_TOKEN=
# PUSHBULLET_DEVICE_IDEN=

# ── phone 게이트웨이 (SMS Gate 앱, Local mode) ──────────────────────────
# 안 쓰는 안드로이드폰 + 문자무제한 유심 + SMS Gate 앱(https://sms-gate.app).
# 앱에서 'Local server'를 켜면 주소/아이디/비번이 표시됩니다. 그 값을 그대로 입력:
# SMS_GATEWAY_URL=http://192.168.0.10:8080
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# 듀얼심이면 발신 슬롯 지정(1 또는 2). 단일심이면 생략.
# SMS_GATEWAY_SIM=1
# 일괄 발송 간격(ms). 너무 빠르면 통신사 스팸필터에 걸림. 기본 2000.
# SMS_SEND_DELAY_MS=2000


# ════════════════════════════════════════════════════════════════════════
#  SOLAPI SMS — SMS_PROVIDER=solapi 일 때만 사용 (건당 과금)
# ════════════════════════════════════════════════════════════════════════
#
# Sends 문자(SMS/LMS) through SOLAPI(구 CoolSMS). Get keys at
# https://console.solapi.com → 개발/연동 > API Key 관리.
#
# 일반 문자 발송에 필요한 값(3개):
#   SOLAPI_API_KEY / SOLAPI_API_SECRET   API 자격증명
#   SOLAPI_ADMIN_PHONE_NUMBER            발신번호 — SOLAPI 콘솔에서 '발신번호
#                                        사전등록'을 마친 번호여야 발송됩니다.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_ADMIN_PHONE_NUMBER=
#
# 카카오 알림톡까지 쓸 때만 추가로 필요(일반 문자엔 불필요):
# KAKAO_BUSINESS_CHANNEL_ID=


# ════════════════════════════════════════════════════════════════════════
#  Other env vars used by the rest of this server (already in production):
# ════════════════════════════════════════════════════════════════════════
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# JWT_SECRET_KEY=
# OPEN_AI_API_KEY=                  # legacy — replaced by LLM_* above
# VOYAGE_API_KEY=
# TOSS_PAYMENTS_SECRET_KEY=
# STATIC_URL=
# (SOLAPI_* / KAKAO_BUSINESS_CHANNEL_ID 는 위 'SOLAPI SMS' 섹션 참고)

# Shared secret gating every /v2/admin/* endpoint (widget CRUD, sessions,
# db/migrate, mail/send). The admin playground sends it as the `x-admin-token` header.
# Set the SAME value here (local) and in the backend's Vercel env vars.
# ADMIN_TOKEN=
