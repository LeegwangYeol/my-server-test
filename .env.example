# ════════════════════════════════════════════════════════════════════════
#  LLM provider configuration — drives /v2/ask
# ════════════════════════════════════════════════════════════════════════
#
# Set LLM_API_KEY to switch /v2/ask from the canned fallback to a real
# streaming LLM response. Leave it blank to keep the demo behavior.
#
# ─ Which vendor? ────────────────────────────────────────────────────────
# Built-in presets (each one just needs its key + optional model):
#
#   openrouter   ← recommended for trying multiple models with one key
#                  Get a key: https://openrouter.ai/keys
#                  Model names: "openai/gpt-4o-mini",
#                               "anthropic/claude-3.5-sonnet",
#                               "meta-llama/llama-3.1-70b-instruct", ...
#
#   openai       https://platform.openai.com/api-keys
#                Models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#
#   groq         https://console.groq.com/keys      (very fast inference)
#                Models: llama-3.1-70b-versatile, mixtral-8x7b-32768
#
#   together     https://api.together.xyz/settings/api-keys
#                Models: meta-llama/Llama-3.1-70B-Instruct-Turbo, ...
#
#   deepseek     https://platform.deepseek.com/api_keys
#                Models: deepseek-chat, deepseek-coder
#
#   mistral      https://console.mistral.ai/api-keys/
#                Models: mistral-small-latest, mistral-large-latest
#
#   fireworks    https://fireworks.ai/account/api-keys
#                Models: accounts/fireworks/models/llama-v3p1-70b-instruct
#
#   custom       Any OpenAI-compatible endpoint — set LLM_BASE_URL too.
#                Examples: self-hosted Ollama, LM Studio, vLLM.
# ─────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=openrouter

#  ⚠️  PUT YOUR API TOKEN HERE  ⚠️
LLM_API_KEY=

# Override the default model for the chosen provider. Optional.
# LLM_MODEL=openai/gpt-4o-mini

# Only required when LLM_PROVIDER=custom.
# LLM_BASE_URL=http://localhost:11434/v1

# Optional: hard cap on output tokens per reply (default 512).
# Keep this low on free tiers — OpenRouter's free credits often allow
# only ~1000 tokens per request and rejects bigger ones with HTTP 402.
# LLM_MAX_TOKENS=512

# Optional: change the assistant's persona.
# LLM_SYSTEM_PROMPT="You are a friendly assistant for example.com."

# Optional: OpenRouter-only attribution headers (shown on its dashboard).
# LLM_REFERER=https://my-server-test.vercel.app
# LLM_TITLE=Tokki Widget


# ════════════════════════════════════════════════════════════════════════
#  Other env vars used by the rest of this server (already in production):
# ════════════════════════════════════════════════════════════════════════
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# JWT_SECRET_KEY=
# OPEN_AI_API_KEY=                  # legacy — replaced by LLM_* above
# VOYAGE_API_KEY=
# TOSS_PAYMENTS_SECRET_KEY=
# KAKAO_BUSINESS_CHANNEL_ID=
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_ADMIN_PHONE_NUMBER=
# STATIC_URL=

# Shared secret gating every /v2/admin/* endpoint (widget CRUD, sessions,
# db/migrate). The admin playground sends it as the `x-admin-token` header.
# Set the SAME value here (local) and in the backend's Vercel env vars.
# ADMIN_TOKEN=
